events {}

http {
  default_type application/json;

  map $http_authorization $llm_authorized {
    default                       0;
    "Bearer ${LLM_BEARER_TOKEN}"  1;
  }

  resolver 127.0.0.11 valid=10s ipv6=off;

  server {
    server_name llm.local.test;

    include /etc/nginx/tls/listen-${LLM_TLS}.conf;

    proxy_read_timeout 600s;
    proxy_send_timeout 600s;

    location /v1/ {
      if ($llm_authorized = 0) {
        add_header WWW-Authenticate 'Bearer realm="llm-https"' always;
        return 401 '{"error":{"message":"Incorrect API key provided. Supply the token as: Authorization: Bearer <token>.","type":"invalid_request_error","param":null,"code":"invalid_api_key"}}';
      }

      set $ollama_upstream "ollama:11434";
      proxy_pass http://$ollama_upstream$request_uri;

      proxy_http_version 1.1;
      proxy_set_header Host $host;
      proxy_set_header Connection "";

      proxy_buffering off;
      proxy_cache off;
    }

    location / {
      return 404 '{"error":{"message":"Unknown endpoint. This server exposes the OpenAI-compatible /v1/ API only.","type":"invalid_request_error","param":null,"code":null}}';
    }
  }
}
